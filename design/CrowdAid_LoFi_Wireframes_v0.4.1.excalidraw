"frameId": null, "roundness": null, "seed": 225239917, "version": 1, "versionNonce": 1073046916, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false, "text": "P0", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "6298fb8beb91498c988a", "originalText": "P0", "autoResize": true, "lineHeight": 1.25}, {"id": "29ec631eec014053aa53", "type": "frame", "x": 2880, "y": 0, "width": 390, "height": 1297.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 763102072, "version": 1, "versionNonce": 524988156, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false, "name": "6 · Practical help  [P0]"}, {"id": "82c43b49eb664e1cbc1c", "type": "rectangle", "x": 2880, "y": 1333.25, "width": 390, "height": 423.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1096223941, "version": 1, "versionNonce": 1339011762, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false}, {"id": "59494a3b777347438bf6", "type": "text", "x": 2894, "y": 1373.25, "width": 328.44, "height": 367.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1569582383, "version": 1, "versionNonce": 1250343784, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false, "text": "• SUCCESS · CAMPAIGN MODE (inline panel\nreplaces the form): \"Thank you for offering\nyour support for Help Usman get kidney\nsurgery. CrowdAid has recorded your offer\nand may contact you if it is needed for\nthis campaign.\" Buttons: 'Back to\ncampaign', 'Donate as well'.\n• SUCCESS · GENERAL MODE: \"Thank you for\noffering your support. CrowdAid may contact\nyou when a relevant opportunity becomes\navailable.\" Buttons: 'Back to home',\n'Browse campaigns'.\n• CrowdAid records every offer and may\nfollow up when necessary. It does not match\nor automatically assign supporters to\npatients, in either mode.\n• Validation, 'Submitting…' button and\nfailure banner (answers kept, Try again)\nuse the shared components.\n• Blood group is never collected or shown\npublicly here.", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• SUCCESS · CAMPAIGN MODE (inline panel\nreplaces the form): \"Thank you for offering\nyour support for Help Usman get kidney\nsurgery. CrowdAid has recorded your offer\nand may contact you if it is needed for\nthis campaign.\" Buttons: 'Back to\ncampaign', 'Donate as well'.\n• SUCCESS · GENERAL MODE: \"Thank you for\noffering your support. CrowdAid may contact\nyou when a relevant opportunity becomes\navailable.\" Buttons: 'Back to home',\n'Browse campaigns'.\n• CrowdAid records every offer and may\nfollow up when necessary. It does not match\nor automatically assign supporters to\npatients, in either mode.\n• Validation, 'Submitting…' button and\nfailure banner (answers kept, Try again)\nuse the shared components.\n• Blood group is never collected or shown\npublicly here.", "autoResize": true, "lineHeight": 1.25}, {"id": "d7715bc1434d414eaeef", "type": "text", "x": 2894, "y": 1345.25, "width": 114.66, "height": 16.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 263675219, "version": 1, "versionNonce