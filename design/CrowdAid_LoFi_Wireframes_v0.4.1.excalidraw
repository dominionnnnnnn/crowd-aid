"endArrowhead": null}, {"id": "ecab8d8c2be4474cbf56", "type": "rectangle", "x": 2564, "y": 974.75, "width": 234.24, "height": 26, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 177752782, "version": 1, "versionNonce": 79746524, "isDeleted": false, "boundElements": [{"id": "0d276c81a6944902915a", "type": "text"}], "updated": 1763729000000, "link": null, "locked": false}, {"id": "0d276c81a6944902915a", "type": "text", "x": 2574.0, "y": 979.62, "width": 214.24, "height": 16.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 946828106, "version": 1, "versionNonce": 734555560, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false, "text": "Real payments = OPTIONAL (P1)", "fontSize": 13, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "ecab8d8c2be4474cbf56", "originalText": "Real payments = OPTIONAL (P1)", "autoResize": true, "lineHeight": 1.25}, {"id": "358813e9c2bd4dba957b", "type": "line", "x": 2550, "y": 987.75, "width": 14, "height": 0.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1181764397, "version": 1, "versionNonce": 904986224, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false, "points": [[0, 0.0], [14, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "784c2d02f1d74f1fa26a", "type": "rectangle", "x": 2160, "y": 1127.75, "width": 390, "height": 493.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 61010792, "version": 1, "versionNonce": 468783920, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false}, {"id": "a17352300c27485d973b", "type": "text", "x": 2174, "y": 1167.75, "width": 318.64, "height": 437.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1649768878, "version": 1, "versionNonce": 591109463, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false, "text": "• BUILD PRIORITY: P0 = simulated payment\nwith the fictional breakdown above.\nOPTIONAL P1 = real provider in test mode\n(only if time allows).\n• Every amount and result in demo mode is\nlabelled simulated/fictional; nothing is\npresented as a real transaction.\n• STATES (inline, same page): Loading =\nbutton 'Processing…' (simulated delay; or\nprovider test checkout if P1 is built).\n• Result panel replaces the form: SUCCESS\n(✓, breakdown, reference, 'Back to\ncampaign' / 'Share') · PENDING ('Campaign\ntotal not changed yet', 'Check status\nagain') · FAILED ('Not charged · No\ndonation recorded', 'Try again' restores\namount, name, email).\n• Only confirmed payments add the donation\namount (never the fee) to the campaign\ntotal.\n• Validation: amount ≥ minimum, valid\nemail. Demo label stays on all states.\n• Demo: a selector or test amount picks\nsuccess / pending / failed so all three can\nbe shown.", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• BUILD PRIORITY: P0 = simulated payment\nwith the fictional breakdown above.\nOPTIONAL P1 = real provider in test mode\n(only if time allows).\n• Every amount and result in demo mode is\nlabelled simulated/fictional; nothing is\npresented as a real transaction.\n• STATES (inline, same page): Loading =\nbutton 'Processing…' (simulated delay; or\nprovider test checkout if P1 is built).\n• Result panel replaces the form: SUCCESS\n(✓, breakdown, reference, 'Back to\ncampaign' / 'Share') · PENDING ('Campaign\ntotal not changed yet', 'Check status\nagain') · FAILED ('Not charged · No\ndonation recorded', 'Try again' restores\namount, name, email).\n• Only confirmed payments add the donation\namount (never the fee) to the campaign\ntotal.\n• Validation: amount ≥ minimum, valid\nemail. Demo label stays on all states.\n• Demo: a selector or test amount picks\nsuccess / pending / failed so all three can\nbe shown.", "autoResize": true, "lineHeight": 1.25}, {"id": "2b621b08e4834919ba1d", "type": "text", "x": 2174, "y": 1139.75, "width": 114.66, "height": 16.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1046785506, "version": 1, "versionNonce": 1975165450, "isDeleted": false, "boundElements": [], "updated": 1763729000000, "link": null, "locked": false, "text": "NOTES & STATES", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "NOTES & STATES", "autoResize": true, "lineHeight": 1.25}, {"id": "e3443e0e30cc4f9abbdd", "type": "text", "x": 2880, "y": -132, "width": 310.72, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1737615249, "version": 1, "versionNonce": 1863047173, "isDeleted": false, "bo