<Project Sdk="Microsoft.NET.Sdk">

  <!-- Business logic and infrastructure (email, Paystack, JWT, hashing).
       Depends only on CrowdAid.Data. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CrowdAid.Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Options, logging, configuration and IHttpClientFactory -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Same IdentityModel line as Microsoft.AspNetCore.Authentication.JwtBearer 8.0.11 -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrowdAid.Data\CrowdAid.Data.csproj" />
  </ItemGroup>

</Project>
