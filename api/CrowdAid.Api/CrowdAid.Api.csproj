<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Outer layer: controllers, middleware, auth wiring, Program.cs. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>CrowdAid.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrowdAid.Service\CrowdAid.Service.csproj" />
    <ProjectReference Include="..\CrowdAid.Data\CrowdAid.Data.csproj" />
  </ItemGroup>

</Project>
