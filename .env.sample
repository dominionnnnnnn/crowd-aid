# Copy to .env ON THE SERVER:  cp .env.sample .env   then edit. Never commit .env.
# Generate random values with:  openssl rand -hex 16   (hex avoids characters that break connection strings)

POSTGRES_USER=crowdaid
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand
POSTGRES_DB=crowdaid_db

# ":80"                      -> plain HTTP on the server IP (first test)
# "<SERVER_IP>.nip.io"       -> automatic HTTPS (needed for the demo)
DOMAIN=:80

# The address people open; used in activation-link emails. Match DOMAIN:
#   http://<SERVER_IP>   or   https://<SERVER_IP>.nip.io
PUBLIC_URL=http://CHANGE_ME_SERVER_IP

# At least 32 random characters:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# Seeded admin account (keep the real password in the team's private notes)
ADMIN_EMAIL=admin@crowdaid.demo
ADMIN_PASSWORD=CHANGE_ME

# Paystack TEST secret key (Dashboard > Settings > API Keys, Test mode). Starts with sk_test_
PAYSTACK_SECRET_KEY=CHANGE_ME_sk_test
